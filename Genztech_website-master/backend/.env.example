# Copy to .env for local dev. On Render, set these in the dashboard.
PORT=8000

# MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017/genztech

# Admin (owner) login — what you'll type into the admin panel password prompt
ADMIN_EMAIL=owner@genztech.local
ADMIN_PASSWORD=change-me-strong-password

# JWT signing secret (any long random string)
JWT_SECRET=replace-with-long-random-string

# Comma-separated allowed origins for CORS.
# Add your Vercel preview + production domains here.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-frontend.vercel.app
